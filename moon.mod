name = "icalendar"

version = "0.1.0"

readme = "README.md"

license = "Apache-2.0"

keywords = [
  "icalendar",
  "calendar",
  "ics",
  "rfc5545",
  "rrule",
  "recurrence",
  "event",
  "scheduling",
]

preferred_target = "wasm"

description = "Pure-MoonBit iCalendar (RFC 5545) parser, serializer and recurrence engine: read and write .ics calendar files with no native dependencies."
